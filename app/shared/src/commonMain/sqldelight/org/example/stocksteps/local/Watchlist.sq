CREATE TABLE watchlist (
    owner TEXT NOT NULL,
    symbol TEXT NOT NULL,
    addedAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    name TEXT,
    exchange TEXT,
    currency TEXT,
    exchangeFullName TEXT,
    PRIMARY KEY (owner, symbol)
);

CREATE TABLE pending_operation (
    revision INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    owner TEXT NOT NULL,
    symbol TEXT NOT NULL,
    addedAt INTEGER,
    updatedAt INTEGER,
    name TEXT,
    exchange TEXT,
    currency TEXT,
    exchangeFullName TEXT,
    UNIQUE (owner, symbol)
);

items:
SELECT * FROM watchlist WHERE owner = ? ORDER BY addedAt, symbol;

item:
SELECT * FROM watchlist WHERE owner = ? AND symbol = ?;

putItem:
INSERT OR REPLACE INTO watchlist(owner, symbol, addedAt, updatedAt, name, exchange, currency, exchangeFullName) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

removeItem:
DELETE FROM watchlist WHERE owner = ? AND symbol = ?;

pending:
SELECT * FROM pending_operation WHERE owner = ? ORDER BY revision;

queue:
INSERT OR REPLACE INTO pending_operation(owner, symbol, addedAt, updatedAt, name, exchange, currency, exchangeFullName) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

acknowledge:
DELETE FROM pending_operation WHERE owner = ? AND revision = ?;

clearGuest:
DELETE FROM watchlist WHERE owner = 'guest';

clearOwnerItems:
DELETE FROM watchlist WHERE owner = ?;

clearOwnerPending:
DELETE FROM pending_operation WHERE owner = ?;

-- Last server copy of signed-in user data (watchlists, alerts, quotes) for offline reading.
-- owner = "<environment>|user:<uid>", so Mock and Real data and different accounts never mix.
CREATE TABLE user_cache (
    owner TEXT NOT NULL,
    cacheKey TEXT NOT NULL,
    json TEXT NOT NULL,
    savedAt INTEGER NOT NULL,
    PRIMARY KEY (owner, cacheKey)
);

cachedValue:
SELECT json, savedAt FROM user_cache WHERE owner = ? AND cacheKey = ?;

putCachedValue:
INSERT OR REPLACE INTO user_cache(owner, cacheKey, json, savedAt) VALUES (?, ?, ?, ?);

clearCacheOwner:
DELETE FROM user_cache WHERE owner LIKE ?;
