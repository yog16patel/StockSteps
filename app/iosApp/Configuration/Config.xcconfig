TEAM_ID=

PRODUCT_NAME=StockSteps
PRODUCT_BUNDLE_IDENTIFIER=org.example.stocksteps

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Kotlin's Xcode build phase generates the framework for this SDK/configuration.
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
OTHER_LDFLAGS = $(inherited) -framework Shared -lsqlite3
