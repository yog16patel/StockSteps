# Copy to deploy/local/server.env (git-ignored) and fill in. No secrets belong here.
# SSH destination of the LAN Docker host (key-based login; the user must be able to run docker).
STOCKSTEPS_SSH=user@192.0.2.10
# The host's LAN IP to publish on. Never 0.0.0.0: the MOCK backend is for the local network only.
STOCKSTEPS_BIND_ADDR=192.0.2.10
# Host port (8081 = the apps' mock-backend port).
STOCKSTEPS_HOST_PORT=8081

# LAN REAL backend (STOCKSTEPS_STACK=real; docs/LOCAL_REAL_BACKEND_PLAN.md). Not secret: keys live only in ~/stocksteps-real/secrets.env on the host.
# STOCKSTEPS_REAL_HOST_PORT=8082
# Your provider plans' request rates per minute (required for the REAL stack) and an optional FMP daily target (an alert, not a cap).
# STOCKSTEPS_REAL_FMP_PER_MINUTE=
# STOCKSTEPS_REAL_FINNHUB_PER_MINUTE=
# STOCKSTEPS_REAL_FMP_DAILY_TARGET=

# REAL signed-in data (owner opt-in; docs/REAL_PORTFOLIO_PRACTICE_FIX.md §6). Needs ~/stocksteps-real/service-account.json on the host
# (owner-placed, owner 10001, mode 400). The project id is the one in app/androidApp/google-services.json (not secret).
# STOCKSTEPS_REAL_USER_DATA=1
# STOCKSTEPS_REAL_FIREBASE_PROJECT_ID=
