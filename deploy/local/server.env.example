# Copy to deploy/local/server.env (git-ignored) and fill in. No secrets belong here.
# SSH destination of the LAN Docker host (key-based login; the user must be able to run docker).
STOCKSTEPS_SSH=user@192.0.2.10
# The host's LAN IP to publish on. Never 0.0.0.0: the MOCK backend is for the local network only.
STOCKSTEPS_BIND_ADDR=192.0.2.10
# Host port (8081 = the apps' mock-backend port).
STOCKSTEPS_HOST_PORT=8081
